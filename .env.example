# Get one at https://developer.clashofclans.com - locked to a specific IP,
# see README.md "Deployment and the IP allowlist problem" before choosing one.
COC_API_TOKEN=""

# Your in-game player tag, including the leading '#', e.g. "#ABC123XYZ".
COC_PLAYER_TAG=""

# Override to route through a static-IP proxy (e.g. the RoyaleAPI proxy) if
# you're not self-hosting somewhere with a fixed IP. Leave unset to call the
# official API directly.
# COC_API_BASE_URL="https://proxy.royaleapi.dev/v1"

# SQLite - a local file, no external database service needed.
DATABASE_URL="file:./dev.db"

# Shared secret required to call /api/cron/sync (as `Authorization: Bearer
# <secret>` or `?secret=<secret>`). Generate with: openssl rand -base64 32
CRON_SECRET=""
